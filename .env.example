# BookIQ Environment Variables
# Copy this to .env for local development
# Set these as Railway environment variables for production

# Django
DJANGO_SECRET_KEY=your-secret-key-here-minimum-50-chars
DJANGO_SETTINGS_MODULE=bookiq.settings_production
DEBUG=False

# Database (Railway injects this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Allowed hosts (comma-separated, no spaces)
# Example: myapp.up.railway.app,myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (comma-separated frontend URLs, or leave blank to allow all)
CORS_ALLOWED_ORIGINS=
